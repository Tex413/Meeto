{
  "name": "meeto",
  "version": "1.0.0",
  "description": "Real-time AI meeting assistant",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "node server.js",
    "build": "electron-builder"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "sql.js": "^1.14.1",
    "stripe": "^14.0.0"
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.meeto.app",
    "productName": "Meeto",
    "win": {
      "target": "nsis"
    },
    "files": [
      "**/*",
      "!*.bat",
      "!*.vbs",
      "!README.txt"
    ]
  }
}
