{
  "name": "meetintel",
  "version": "2.0.0",
  "description": "Real-time AI meeting assistant",
  "author": "Meetintel",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "electron": "electron main.js",
    "desktop": "electron main.js",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir",
    "docker:build": "docker build -t meetintel .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "mammoth": "^1.12.0",
    "nodemailer": "^8.0.9",
    "pdf-parse": "^2.4.5",
    "sql.js": "^1.14.1",
    "stripe": "^14.0.0"
  },
  "build": {
    "appId": "io.meetintel.desktop",
    "productName": "Meetintel",
    "directories": { "output": "dist" },
    "npmRebuild": false,
    "files": [
      "**/*",
      "!data/**",
      "!keys/**",
      "!dist/**",
      "!*.bak",
      "!Dockerfile",
      "!docker-compose.yml",
      "!.env*",
      "!ROADMAP.md",
      "!**/*.{md,map}",
      "!node_modules/onnxruntime-node/bin/napi-v3/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v3/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v3/win32/arm64/**"
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/@napi-rs/**",
      "node_modules/sql.js/dist/*.wasm"
    ],
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
