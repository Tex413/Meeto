# Copy this file to data/.env and fill in your values.
# The data/ directory is gitignored and persisted via Docker volume.

# Your public-facing URL — used for Secure cookies, Stripe callbacks, and password reset links
PUBLIC_URL=https://meetintel.io

# Cloudflare Tunnel token
# Get it: Zero Trust → Networks → Tunnels → your tunnel → Configure → Docker install command
# Copy only the token value (the long eyJ... string at the end)
TUNNEL_TOKEN=eyJ...your-token-here

# LM Studio backend (Settings → AI Provider → LM Studio). The address must be on this machine or your network.
# LMSTUDIO_MODEL is the identifier of the model loaded in LM Studio (see GET <address>/models).
# In Docker the address defaults to http://host.docker.internal:1234/v1 (LM Studio on the Docker host);
# otherwise http://localhost:1234/v1. For another machine, use its address and turn on
# "Serve on Local Network" in LM Studio. Uncomment to set:
# LMSTUDIO_URL=http://192.168.1.50:1234/v1
LMSTUDIO_MODEL=your-loaded-model-id
# Optional: request timeout in milliseconds, and reasoning effort (use "none" if a reasoning model returns no text)
# LMSTUDIO_TIMEOUT_MS=120000
# LMSTUDIO_REASONING_EFFORT=none

# License key signing secret — keep private and constant across deploys
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LICENSE_SECRET=replace-with-a-random-secret

# Stripe (optional — only needed to sell licenses via the landing page)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# SMTP for password reset emails (optional — without this, reset links appear in /admin → Users)
# Works with any SMTP provider: Gmail (port 587), SendGrid, Postmark, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@meetintel.io
