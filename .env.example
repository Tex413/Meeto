# Copy this file to data/.env and fill in your values.
# The data/ directory is gitignored and persisted via Docker volume.

# Your public-facing URL — used for Secure cookies, Stripe callbacks, and password reset links
PUBLIC_URL=https://meetintel.io

# Cloudflare Tunnel token
# Get it: Zero Trust → Networks → Tunnels → your tunnel → Configure → Docker install command
# Copy only the token value (the long eyJ... string at the end)
TUNNEL_TOKEN=eyJ...your-token-here

# License key signing secret — keep private and constant across deploys
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LICENSE_SECRET=replace-with-a-random-secret

# Stripe (optional — only needed to sell licenses via the landing page)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# SMTP for password reset emails (optional — without this, reset links appear in /admin → Users)
# Works with any SMTP provider: Gmail (port 587), SendGrid, Postmark, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@meetintel.io
